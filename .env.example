# =============================================================================
# TEMPLATE DE VARIABLES DE ENTORNO — TFG Universidad RAG
# Copiar este archivo como .env y rellenar con valores reales.
# NUNCA subir el archivo .env al repositorio.
# =============================================================================

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_SEARCH_SERVICE_ENDPOINT=https://<tu-servicio>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=university-corpus

# Base de datos local
SQLITE_DB_PATH=data/database/students.db

# Configuración del sistema
MAX_RETRIEVED_DOCS=5
RETRIEVAL_SCORE_THRESHOLD=0.7
DEBUG_MODE=false

# Checkpointer (false = MemorySaver en memoria, true = SqliteSaver persistente)
USE_SQLITE_CHECKPOINTER=false

# Credenciales del sistema de autenticacion
STUDENT_PASSWORD=
ADMIN_PASSWORD=
